# FireSight AI — Git Ignore Rules

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging
build/
dist/
*.egg-info/
.eggs/
wheels/

# Secrets and local environment
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key
secrets/
credentials/

# Jupyter
.ipynb_checkpoints/

# IDE and OS files
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Model weights and generated ML artifacts
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.tflite
*.h5
*.keras
models/checkpoints/
models/weights/
runs/
wandb/
mlruns/

# Datasets — do not commit raw or processed data
data/raw/*
data/processed/*
data/annotations/*
data/interim/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/annotations/.gitkeep
!data/interim/.gitkeep

# Generated reports and outputs
reports/figures/*
reports/results/*
reports/phase02/figures/*
reports/phase02/results/*
output/
inference-results/

# Keep placeholder files
!.gitkeep

# Generated archives — review before intentionally committing
*.zip
*.7z
*.rar
*.tar
*.gz
# Generated training history and plots
reports/training/*
!reports/training/.gitkeep

# FireSight API runtime outputs
outputs/

